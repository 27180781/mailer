{
  "providerId": "retsef.co.il",
  "providerName": "Retzef Mailer",
  "serviceId": "mailer-nodmarc",
  "serviceName": "Email sending (DKIM, MAIL FROM)",
  "version": 1,
  "logoUrl": "https://mail.retsef.co.il/app/logo.svg",
  "description": "Adds the DNS records to send authenticated email through the Retzef mailer (Amazon SES): DKIM and a custom MAIL FROM domain with SPF. For domains that already publish DMARC.",
  "variableDescription": "dkim1, dkim2, dkim3: the Amazon SES Easy DKIM tokens of the domain; region: the Amazon SES region (e.g. il-central-1)",
  "syncBlock": false,
  "sharedProviderName": false,
  "syncPubKeyDomain": "retsef.co.il",
  "syncRedirectDomain": "mail.retsef.co.il",
  "hostRequired": false,
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.%region%.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.%region%.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.%region%.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    }
  ]
}
