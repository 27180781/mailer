{
  "name": "mailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "פלטפורמת דיוור מרובת חשבונות עם API מלא",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && cp -r src/migrations dist/",
    "start": "node dist/main.js",
    "migrate": "node dist/main.js migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
