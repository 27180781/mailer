{
  "url": "/contacts/{{encodeURL(parameters.contact)}}",
  "method": "PATCH",
  "body": {
    "email": "{{ifempty(parameters.new_email; undefined)}}",
    "name": "{{ifempty(parameters.name; undefined)}}",
    "attributes": "{{if(length(parameters.attributes) > 0; toCollection(parameters.attributes; \"key\"; \"value\"); undefined)}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
