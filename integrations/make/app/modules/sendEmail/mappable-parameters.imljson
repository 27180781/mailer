  },
  {
    "name": "text",
    "type": "text",
    "label": "תוכן (טקסט רגיל)",
    "multiline": true
  },
  {
    "name": "type",
    "type": "select",
    "label": "סוג",
    "required": true,
    "default": "transactional",
    "options": [
      {
        "label": "תפעולי (אישור הזמנה, חשבונית)",
