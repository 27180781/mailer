      {
        "name": "key",
        "type": "text",
        "label": "שם",
        "required": true
      },
      {
        "name": "value",
        "type": "text",
        "label": "ערך"
      }
    ]
  },
  {
    "name": "idempotency_key",
    "type": "text",
    "label": "מפתח למניעת כפילות",
